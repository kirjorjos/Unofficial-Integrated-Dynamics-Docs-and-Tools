# Same ignores as the app branches (1.19.2/main), adapted for the build store:
# the store must stay tracked, so .gitattributes is un-ignored (the `.*` rule
# below would otherwise swallow it) and builds/ is never ignored.
.*
!.gitignore
!.gitattributes
!.prettierignore
!.github/
.envrc

boot.sh
Integrated Dynamics Website.code-workspace
.DS_Store

node_modules/
docs/
_site/
*.log
*.disabled

# Playwright artifacts (baselines themselves live in src/assets/visual-snapshots/)
test-results/
playwright-report/
scripts/.gen-*

# Local screenshot sandbox (`npm run generate-screenshots`) — machine-specific
# PNGs never enter PRs; committed baselines are always CI-born (spec §3.7).
/.local-snapshots/
